{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pdf2qti Configuration",
  "description": "Configuration schema for pdf2qti quiz generation",
  "type": "object",
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Config schema version (must be 1)"
    },
    "courseName": {
      "type": "string",
      "description": "Course-wide display name, used to fill the subtitle placeholder on generated PPTX title slides"
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/definitions/module" }
    }
  },
  "definitions": {
    "optionRange": {
      "type": "object",
      "properties": {
        "min": { "type": "integer", "minimum": 2 },
        "max": { "type": "integer", "minimum": 2 }
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "tf": { "type": "integer", "minimum": 0 },
        "ma": { "type": "integer", "minimum": 0 },
        "mc": { "type": "integer", "minimum": 0 }
      }
    },
    "quiz": {
      "type": "object",
      "properties": {
        "titleTemplate": { "type": "string" },
        "descriptionTemplate": { "type": "string" },
        "counts": { "$ref": "#/definitions/counts" },
        "mcOptions": { "$ref": "#/definitions/optionRange" },
        "maOptions": { "$ref": "#/definitions/optionRange" }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": { "type": "string", "enum": ["tf", "ma", "mc"] }
        },
        "instructions": { "type": "string", "description": "Additional quiz-generation prompt instructions. A nonempty source value replaces the default instructions." },
        "seed": { "type": "integer" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "apiKeyEnv": { "type": "string" },
        "modelParams": {
          "type": "object",
          "description": "Arbitrary provider-specific model parameters (e.g. temperature, reasoning_effort), merged directly into the provider's request body."
        }
      }
    },
    "distill": {
      "type": "object",
      "properties": {
        "grounding": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["fail", "drop", "warn"],
              "description": "Handling for distilled factual content unsupported by original source; defaults to fail."
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "forbiddenPhrases": {
          "type": ["array", "null"],
          "items": { "type": "string" },
          "description": "Go regular expressions rejected in question and option text, including matching answers. Omitted or null inherits defaults; a source array replaces defaults; [] disables this check. Custom rules are case-sensitive unless they include (?i). Malformed rules fail config validation.",
          "default": ["(?i)\\bthe\\s+source\\b", "(?i)\\bthe\\s+text\\b", "(?i)\\bthe\\s+chapter\\b", "(?i)\\bthe\\s+passage\\b", "(?i)\\bthe\\s+author\\b"]
        },
        "maMaxCorrectDensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "enforceUniqueOptionsPerQuestion": { "type": "boolean" },
        "requireSequentialNumbering": { "type": "boolean" },
        "requireExactlyOneCorrectForTfMc": { "type": "boolean" }
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "outDir": { "type": "string" },
        "openReview": { "type": "boolean" },
        "reviewTarget": { "type": "string" },
        "requireApprovalBeforeBuild": { "type": "boolean" },
        "packageZip": { "type": "boolean" }
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "quiz": { "$ref": "#/definitions/quiz" },
        "generation": { "$ref": "#/definitions/generation" },
		"distill": { "$ref": "#/definitions/distill" },
        "validation": { "$ref": "#/definitions/validation" },
        "workflow": { "$ref": "#/definitions/workflow" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id"],
      "oneOf": [
        { "required": ["pdf"], "not": { "required": ["context"] } },
        { "required": ["context"], "not": { "required": ["pdf"] } }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "chapter": { "type": "integer", "minimum": 0 },
        "pdf": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "required": ["files"],
          "properties": {
            "files": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["path"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "sections": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "include_preamble": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "quiz": { "$ref": "#/definitions/quiz" },
        "generation": { "$ref": "#/definitions/generation" },
		"distill": { "$ref": "#/definitions/distill" },
        "validation": { "$ref": "#/definitions/validation" },
        "workflow": { "$ref": "#/definitions/workflow" }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "name", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
